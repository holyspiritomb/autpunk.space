<IfModule mod_headers.c>
    # Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer, strict-origin-when-cross-origin"
</IfModule>
RewriteEngine on
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(.+\.)?autpunk\.space/ [NC]
RewriteCond %{REQUEST_URI} !blocked\.gif$ [NC]
RewriteRule .*\.(jpe?g|gif|png)$ https://autpunk.space/blocked.gif [L]
